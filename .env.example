# Copy to .env.local. Never commit real credentials.
DATABASE_URL=
# Direct connection for schema migrations (populated by neon deploy)
DATABASE_URL_UNPOOLED=

# MND CSV import (server-only)
CSV_DOWNLOAD_URL=https://opendata.mnd.go.kr/openinf/opencom/down2csv.jsp
CRON_SECRET=

# NextAuth + Kakao (http://localhost:3000/api/auth/callback/kakao)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
